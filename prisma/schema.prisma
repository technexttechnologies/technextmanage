generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Entity Models

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              String             @default("SALES") // SUPER_ADMIN, ADMIN, HEAD, SALES, PROJECT, SUPPORT
  customers         Customer[]
  leads             Lead[]
  tasks             Task[]
  followUps         FollowUp[]
  projects          Project[]
  quotations        Quotation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  Document          Document[]
  requestedQuotes   QuotationRequest[] @relation("RequestedQuotes")
  assignedQuotes    QuotationRequest[] @relation("AssignedQuotes")
  requestedInvoices InvoiceRequest[]   @relation("RequestedInvoices")
  assignedInvoices  InvoiceRequest[]   @relation("AssignedInvoices")
  activityLogs      ActivityLog[]
  projectNotes      ProjectNote[]
  assignedTickets   SupportTicket[]    @relation("AssignedTickets")
  ticketMessages    TicketMessage[]
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id])
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  notifications     InAppNotification[]
  resetTokens       PasswordResetToken[]

  // ERP Relations
  erpIncomesRecorded ErpIncome[]  @relation("ErpIncomeRecordedBy")
  erpExpensesRecorded ErpExpense[] @relation("ErpExpenseRecordedBy")
  erpExpensesApproved ErpExpense[] @relation("ErpExpenseApprovedBy")
  erpAssetsAssigned  ErpAsset[]   @relation("ErpAssetAssigned")
  erpMailsSent       ErpMail[]    @relation("ErpMailSent")
  erpEventsCreated   ErpEvent[]   @relation("ErpEventCreated")
  erpDocsUploaded    ErpDocument[] @relation("ErpDocumentUploaded")
}

model Customer {
  id             String    @id @default(cuid())
  customerNumber Int       @default(autoincrement()) @unique
  name           String
  company       String?
  phone         String
  email         String?
  gstNumber     String?
  address       String?
  notes         String?
  status        String    @default("LEAD") // LEAD, PROSPECT, ACTIVE, PROJECT_RUNNING, SUPPORT_REQUIRED, RENEWAL_DUE, INACTIVE
  assignedToId  String
  assignedTo    User      @relation(fields: [assignedToId], references: [id])
  // Aronium Fields
  aroniumId     String?
  aroniumCode   String?
  syncStatus    String    @default("PENDING") // SYNCED, PENDING, FAILED
  lastSyncDate  DateTime?
  billingNotes  String?
  paymentStatus String?
  
  // Reseller Remote Credentials
  anydeskId      String?
  teamviewerId   String?
  pcLoginDetails String? @db.Text

  projects          Project[]
  followUps         FollowUp[]
  renewals          Renewal[]
  aroniumRefs       AroniumReference[]
  quotations        Quotation[]
  quotationRequests QuotationRequest[]
  invoiceRequests   InvoiceRequest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  Document          Document[]
  amcs              AMC[]
  supportTickets    SupportTicket[]
  campaignLogs      CampaignLog[]
  packages          ServicePackage[]
  domains           DomainRegistration[]
  hostingAccounts   HostingAccount[]
  appointments      Appointment[]
  portalToken       String?            @unique
}

model Lead {
  id           String   @id @default(cuid())
  source       String
  status       String   @default("NEW") // NEW, CONTACTED, QUALIFIED, FOLLOW_UP, CONVERTED, LOST
  notes        String?
  assignedToId String
  assignedTo   User     @relation(fields: [assignedToId], references: [id])
  name         String
  phone        String?
  email        String?
  company      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id              String             @id @default(cuid())
  name            String
  description     String?            @db.Text
  type            String?            // Website, App, SEO, etc.
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id])
  startDate       DateTime
  endDate         DateTime?          // Expected Delivery Date
  progress        Int                @default(0) // 0-100
  status          String             @default("PROJECT_RECEIVED") // PROJECT_RECEIVED, REQUIREMENT_ANALYSIS, PLANNING, UI_UX_DESIGN, DEVELOPMENT, TESTING, CLIENT_REVIEW, REVISION, DEPLOYMENT, COMPLETED, ON_HOLD
  priority        String             @default("MEDIUM")
  assignedToId    String?
  assignedTo      User?              @relation(fields: [assignedToId], references: [id])
  tasks           Task[]
  notes           ProjectNote[]
  hardware        ProjectHardware[]
  milestones      ProjectMilestone[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  Document        Document[]
  invoiceRequests InvoiceRequest[]
  supportTickets  SupportTicket[]
  amcs            AMC[]
  warrantyEndDate DateTime?
  freeUpdatesEndDate DateTime?
  amcId           String?
  // Reseller License Tracking
  licenseKey         String?
  licenseType        String?
  softwareVersion    String?
  machineId          String?
}

model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectHardware {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemName    String
  serialNo    String?
  warrantyEnd DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  assignedToId String
  assignedTo   User      @relation(fields: [assignedToId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  priority     String    @default("MEDIUM")
  dueDate      DateTime?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model FollowUp {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  type         String // Call, WhatsApp, Email, Meeting
  date         DateTime
  status       String   @default("PENDING") // PENDING, COMPLETED
  notes        String?
  assignedToId String
  assignedTo   User     @relation(fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Renewal {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  type         String // Domain, Hosting, SSL, Service
  expiryDate   DateTime
  status       String    @default("ACTIVE") // ACTIVE, RENEWED, EXPIRED
  lastReminded DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AroniumReference {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  refType    String // Invoice, Quotation, Payment
  refNumber  String
  notes      String?
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  date            DateTime
  totalAmount     Float
  subtotal        Float    @default(0)
  gstPercentage   Float    @default(18)
  status          String   @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED, CONVERTED
  notes           String?
  pdfUrl          String? // For uploaded PDFs or backup original PDF
  
  // New Structured AI Data fields
  expiryDate      DateTime?
  companyName     String?
  companyAddress  String?
  companyGst      String?
  needsReview     Boolean  @default(false)
  meta            Json?    // Stores smart detection meta like package types (Website, SEO, etc)
  
  // Relations for structured data
  items           QuotationItem[]
  terms           QuotationTerm[]
  milestones      QuotationMilestone[]

  assignedToId    String?
  assignedTo      User?    @relation(fields: [assignedToId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  description String?   @db.Text
  quantity    Int       @default(1)
  price       Float
  total       Float
}

model QuotationTerm {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  order       Int       @default(0)
}

model QuotationMilestone {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  duration    String?
  order       Int       @default(0)
}

model SyncLog {
  id           String   @id @default(cuid())
  type         String // CUSTOMER, QUOTATION, INVOICE
  status       String // SUCCESS, FAILED
  details      String?
  recordsAdded Int      @default(0)
  createdAt    DateTime @default(now())
}

model SystemSettings {
  id                 String   @id @default(cuid())
  aroniumDbPath      String?
  autoSyncEnabled    Boolean  @default(false)
  syncIntervalMins   Int      @default(60)
  smtpEmail          String?
  smtpPassword       String?
  reminderEnabled    Boolean  @default(false)
  enquirySheetUrl    String?
  enquirySyncEnabled Boolean  @default(false)
  geminiApiKey       String?
  updatedAt          DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  status    String // SENT, FAILED
  error     String?
  createdAt DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  subject     String
  body        String   @db.Text
  audience    String   // ALL_CUSTOMERS, ACTIVE_AMCS, LEADS
  sentCount   Int      @default(0)
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String?
  body      String
  type      String // EMAIL, WHATSAPP
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id           String    @id @default(cuid())
  fileName     String
  fileUrl      String    @db.Text
  fileSize     Int
  mimeType     String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
}

model QuotationRequest {
  id                 String   @id @default(cuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  serviceName        String
  requirementDetails String   @db.Text
  budget             String?
  subtotal           Float    @default(0)
  gstPercentage      Float    @default(18)
  priority           String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status             String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, QUOTATION_GENERATED, PDF_UPLOADED, SENT_TO_CUSTOMER, ACCEPTED, REJECTED
  pdfUrl             String?
  structuredData     Json?    // AI Parsed PDF data
  adminNotes         String?  @db.Text
  aroniumQuotationNo String?
  requestedById      String
  requestedBy        User     @relation("RequestedQuotes", fields: [requestedById], references: [id])
  assignedAdminId    String?
  assignedAdmin      User?    @relation("AssignedQuotes", fields: [assignedAdminId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InvoiceRequest {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id])
  amountRequested  Float
  subtotal         Float    @default(0)
  gstPercentage    Float    @default(18)
  notes            String?  @db.Text
  status           String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, INVOICE_GENERATED, PDF_UPLOADED, SENT_TO_CUSTOMER, PAID, CANCELLED
  pdfUrl           String?
  structuredData   Json?    // AI Parsed PDF data
  adminNotes       String?  @db.Text
  aroniumInvoiceNo String?
  requestedById    String
  requestedBy      User     @relation("RequestedInvoices", fields: [requestedById], references: [id])
  assignedAdminId  String?
  assignedAdmin    User?    @relation("AssignedInvoices", fields: [assignedAdminId], references: [id])
  lastReminderSentAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String // QUOTATION_REQUEST, INVOICE_REQUEST, CUSTOMER
  entityId   String
  details    String?  @db.Text
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model AMC {
  id          String   @id @default(cuid())
  amcNumber   Int      @default(autoincrement()) @unique
  title       String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  amount      Float
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  amcType     String   @default("GENERAL") // GENERAL, SOFTWARE_RESELLING, CUSTOM_DEVELOPMENT
  paymentStatus String @default("PENDING") // PENDING, PAID
  notes       String?  @db.Text
  lastReminderSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id           String   @id @default(cuid())
  subject      String
  description  String   @db.Text
  priority     String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("AssignedTickets", fields: [assignedToId], references: [id])
  messages     TicketMessage[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String?  // null if sent by customer via public link
  sender    User?    @relation(fields: [senderId], references: [id])
  message   String   @db.Text
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())
}

model MarketingCampaign {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String   @db.Text
  status      String   @default("DRAFT") // DRAFT, SCHEDULED, SENDING, COMPLETED
  audience    String   // ALL, ACTIVE, RENEWAL_DUE, LEAD, etc.
  scheduledAt DateTime?
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        CampaignLog[]
}

model CampaignLog {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  status      String   // SENT, FAILED
  error       String?
  sentAt      DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  clockIn   DateTime
  clockOut  DateTime?
  status    String   @default("PRESENT") // PRESENT, LATE, HALF_DAY
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // SICK, CASUAL, EARNED
  startDate DateTime
  endDate   DateTime
  reason    String   @db.Text
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InAppNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  link      String?  // Optional URL to navigate to
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ServicePackage {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageName     String
  packageType     String   // WEBSITE, ECOMMERCE, SEO, MARKETING, SOFTWARE, CUSTOM
  packagePrice    Float
  purchaseDate    DateTime
  renewalDate     DateTime?
  isLifetime      Boolean  @default(false)
  contractPeriod  Int      // in months
  status          String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  assignedTeam    String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DomainRegistration {
  id                String   @id @default(cuid())
  domainName        String   @unique
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  registrar         String
  registrationDate  DateTime
  expiryDate        DateTime
  renewalDate       DateTime?
  autoRenewalStatus Boolean  @default(false)
  dnsDetails        String?  @db.Text
  nameservers       String?  @db.Text
  domainCost        Float
  status            String   @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HostingAccount {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  hostingProvider   String
  hostingPlan       String
  serverLocation    String?
  renewalDate       DateTime?
  isLifetime        Boolean  @default(false)
  hostingCost       Float
  storageUsage      String?
  bandwidthUsage    String?
  sslStatus         String   @default("ACTIVE") // ACTIVE, EXPIRING, EXPIRED
  backupStatus      String   @default("ENABLED") // ENABLED, DISABLED, FAILED
  status            String   @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Appointment {
  id             String   @id @default(cuid())
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  meetingPurpose String
  date           DateTime
  time           String
  meetingType    String   // ONLINE, OFFLINE, PHONE
  assignedStaff  String?
  notes          String?  @db.Text
  googleEventId  String?
  meetLink       String?
  status         String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// BUSINESS OPERATIONS (ERP) MODULE
// Completely isolated from Customer CRM
// ==========================================

model ErpIncome {
  id            String   @id @default(cuid())
  incomeId      String   @unique @default(cuid()) // Human readable generated later
  customerName  String?
  service       String
  category      String
  amount        Float
  gst           Float    @default(0)
  paymentMethod String
  paymentDate   DateTime
  invoiceRef    String?
  notes         String?  @db.Text
  attachments   String?  @db.Text // JSON string of urls
  recordedById  String
  recordedBy    User     @relation("ErpIncomeRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ErpExpense {
  id            String   @id @default(cuid())
  title         String
  category      String
  vendor        String?
  amount        Float
  gst           Float    @default(0)
  paymentMethod String
  paymentDate   DateTime
  receiptUrl    String?  @db.Text
  notes         String?  @db.Text
  status        String   @default("PENDING") // PENDING, APPROVED, PAID
  approvedById  String?
  approvedBy    User?    @relation("ErpExpenseApprovedBy", fields: [approvedById], references: [id])
  recordedById  String
  recordedBy    User     @relation("ErpExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ErpVendor {
  id             String   @id @default(cuid())
  companyName    String
  contactPerson  String?
  email          String?
  phone          String?
  gstNumber      String?
  address        String?  @db.Text
  services       String?  @db.Text
  paymentTerms   String?
  outstandingBal Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ErpAsset {
  id                 String   @id @default(cuid())
  assetId            String   @unique
  name               String
  category           String   // Laptop, Server, Printer, etc.
  purchaseDate       DateTime
  purchaseCost       Float
  warrantyEnd        DateTime?
  assignedToId       String?
  assignedTo         User?    @relation("ErpAssetAssigned", fields: [assignedToId], references: [id])
  status             String   @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED
  maintenanceHistory String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ErpSubscription {
  id              String   @id @default(cuid())
  name            String
  provider        String
  cost            Float
  billingCycle    String   // MONTHLY, YEARLY
  nextBillingDate DateTime
  reminderSent    Boolean  @default(false)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ErpMail {
  id           String   @id @default(cuid())
  subject      String
  body         String   @db.Text
  senderId     String
  sender       User     @relation("ErpMailSent", fields: [senderId], references: [id])
  recipient    String
  cc           String?
  bcc          String?
  isInternal   Boolean  @default(true)
  status       String   @default("SENT") // DRAFT, SCHEDULED, SENT, TRASH
  attachments  String?  @db.Text // JSON string
  scheduledAt  DateTime?
  createdAt    DateTime @default(now())
}

model ErpEvent {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  type        String   // MEETING, HOLIDAY, HR, EVENT
  date        DateTime
  startTime   String?
  endTime     String?
  location    String?
  meetLink    String?
  isRecurring Boolean  @default(false)
  createdById String
  createdBy   User     @relation("ErpEventCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ErpDocument {
  id           String   @id @default(cuid())
  name         String
  folder       String   @default("General")
  fileUrl      String   @db.Text
  version      Int      @default(1)
  uploadedById String
  uploadedBy   User     @relation("ErpDocumentUploaded", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
